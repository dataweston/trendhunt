{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/trends.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/discover.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/queue.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/generate-page.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/meta-ads.ts": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/meta-sync.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/meta-analyze.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/meta-webhook.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/ga4-backtest.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/cron-score.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/ga4-funnel.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/evaluate-launches.ts": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/calibrate.ts": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/analyze-trend.ts": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/discover",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-score",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/ga4-funnel",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/meta-sync",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/meta-analyze",
      "schedule": "40 * * * *"
    }
  ]
}
